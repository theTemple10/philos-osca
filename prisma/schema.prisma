generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth Models ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubId      String?   @unique
  githubLogin   String?   @unique
  accessToken   String?
  refreshToken  String?

  // Skill profile (auto-detected from repos)
  skillProfile  Json?     // { languages: [...], frameworks: [...], strengths: [...], weaknesses: [...] }

  // Preferences
  preferredAiProvider String? @default("openai")
  preferredAiModel    String? @default("gpt-4o")
  difficultyLevel     String? @default("adaptive") // beginner, intermediate, advanced, adaptive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  repositories  UserRepo[]
  contributions Contribution[]
  pullRequests  PullRequest[]
}

model UserRepo {
  id            String   @id @default(cuid())
  userId        String
  githubRepoId  Int
  name          String
  fullName      String
  description   String?
  url           String
  language      String?
  languages     Json?    // { TypeScript: 85.2, JavaScript: 14.8 }
  topics        Json?    // ["react", "nextjs"]
  starsCount    Int      @default(0)
  forksCount    Int      @default(0)
  lastPushedAt  DateTime?
  analyzedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, githubRepoId])
}

model Contribution {
  id              String   @id @default(cuid())
  userId          String
  targetRepoOwner String
  targetRepoName  String
  targetRepoUrl   String
  issueNumber     Int?
  issueTitle      String?
  issueBody       String?
  issueLabels     Json?
  issueUrl        String?

  // Analysis results
  difficulty      String?  // easy, medium, hard
  skillMatch      Float?   // 0.0 - 1.0
  suggestedApproach String?
  relevantFiles   Json?    // ["src/components/Button.tsx"]

  // Status tracking
  status          String   @default("discovered") // discovered, selected, analyzing, coding, reviewing, pr_created, merged, declined

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequests PullRequest[]
}

model PullRequest {
  id              String   @id @default(cuid())
  userId          String
  contributionId  String?
  githubPrNumber  Int?
  githubPrUrl     String?
  githubPrId      Int?
  title           String
  body            String?
  branchName      String
  baseBranch      String   @default("main")
  status          String   @default("draft") // draft, submitted, review_requested, approved, merged, closed

  // Generated content
  generatedCode   Json?    // { files: [{ path, content, action }] }
  commitMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contribution Contribution? @relation(fields: [contributionId], references: [id])
}
